*{
    box-sizing: border-box;
    outline: none;
}
html, body{
    min-height: 100%;
    margin:0;
}
body{
    font-family: "Roboto", sans-serif;

    font-size: var(--base-size);
    color: var(--fore-color);
}
a{
    text-decoration: none;
}
p{
    margin: 0;
    line-height: 1.8;
}
.sp-section-subtitle,
.sp-section-title,
.sp-product-title{
    margin: 0;
    line-height: 1.6;
}

.sp-section-title{
    font-size: 3.5em;
}
.sp-section-subtitle{
    font-size: 1.7em;
}
.sp-main{
    pointer-events: all;
}
.sp-main-nav{
    margin-top: 70px;
    position: sticky;

  
    width: 100%;
    padding: 12px 0;
    
    background-color: var(--fore-color);
    color:var(--back-color);

    z-index: 4;
}
.sp-main-nav-container{
    display: flex;

    margin: auto;
    justify-content: space-between;
    max-width: 960px;
    align-items: center;
}
.sp-main-nav .sp-logo{
    font-size: 1.8em;
    color: var(--back-color);
}
.sp-main-search{
    position: relative;

    width: 450px;
}
.sp-main-search input[type="text"]{
    width:100%;
    padding: 12px;
    padding-left: 48px;
    
    border-radius: 20px;
    border: none;
    background-color: var(--back-color-faded);
    color:var(--back-color);
}
.sp-main-search .sp-search-placeholder{
    position: absolute;
    display: flex;

    justify-content: center;
    align-items: center;
    margin: auto;

    left:0;
    top:0;
    bottom: 0;
    right: 0;

    transition: ease-in-out .3s;
    pointer-events: none;
}
.sp-search-placeholder .sp-search-icon{
    color:var(--back-color);
}
.sp-search-placeholder .sp-search-placeholder-text{
    margin-left: 8px;
    
    color:var(--back-color-faded);

    transition: ease-in-out .3s;
}

.sp-main-search input[type="text"]:focus + .sp-search-placeholder,
.sp-main-search input[type="text"]:valid + .sp-search-placeholder{
    transform: translate3d(-40%, 0px, 0px);
}

.sp-main-search input[type="text"]:focus + .sp-search-placeholder .sp-search-placeholder-text,
.sp-main-search input[type="text"]:valid + .sp-search-placeholder .sp-search-placeholder-text{
    opacity: 0;
}
.sp-nav-right-items a{
    font-size: 1.2em;
    padding-left:12px;
    color:var(--back-color);
}


.sp-product-details{
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 64px;
    max-width: 960px;
    padding: 72px 0;
    margin: auto;
}
.sp-product-details-container{
    background-color: #ffffff;
    position: relative;
    z-index: 1;
}
.sp-product-image{
    text-align:center;
    display: none;
}
.sp-product-image.sp-show{
    display: block;
}
.sp-product-image-container{
    position: sticky;

    top: 72px;
}

.sp-product-offers{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;

    margin-top:24px;
}
.sp-product-offer{
    text-align: center;
}
.sp-offer-icon{
    margin-bottom: 6px;

    font-size: 1.6em;
    color:rgba(0,0,0,0.4)
}
.sp-offer-description{
    font-weight: 300;
}

.sp-product-title{
    font-size:3.5em;
}
.sp-product-price{
    margin-bottom: 64px;
    margin-top:0px;

    font-size: 2.4em;
    font-weight: 400;
}
.sp-variations-selection{
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-gap: 16px;

    margin-bottom: 32px;;

}
.sp-variation{
    padding:16px;

    text-align: center;
    color:var(--fore-color);
    border: 1px solid rgba(0,0,0,0.1);

    transition:ease-in-out .3s;
}
.sp-variation:hover{
    border: 1px solid rgba(0,0,0,0.5);
}
.sp-variation.sp-selected{
    color: var(--primary-color);
    border-color: var(--primary-color);
}
.sp-variations-selection .sp-section-subtitle{
    grid-column: 1 / 3;
}
.sp-variation i{
    font-size:3em;
}
.sp-space-gray{
    color: #52514f
}
.sp-silver{
    color: #ebebe3
}
.sp-midnight-green{
    color: #6d7a71
}
.sp-gold{
    color: #fbd7bd
}
.sp-variation h3{
    margin: 0;

    font-size:2.5em;
    font-weight: 400;
}

.sp-dark-section{
    color: var(--back-color);
    background-color: var(--fore-color);
    position: sticky;
    bottom: 0;
}
.sp-about-product{
    text-align: center;
    padding: 621px 0 0 0;
}

.sp-about-product h2,
.sp-about-product p{
    position:relative;

    width:850px;
    margin: auto;

    z-index:3;
}
.sp-about-product h2{
    margin-bottom: 32px;
}
.sp-about-product p{
    margin-bottom: 72px;
}
.sp-iphone-banner{
    position:sticky;

    bottom:0;
    height: 555px;
    z-index:0;
    background-image: url("https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-11-pro-gallery-2019-4?wid=1680&hei=640&fmt=jpeg&qlt=95&op_usm=0.5,0.5&.v=1567208465124");
    /* background-attachment: fixed; */
    background-position: center;
    background-repeat: no-repeat;
}

.sp-gray-section{
    background-color: #2B2B2B;
}

.sp-product-features{
    padding: 72px 0;
    position: sticky;
    z-index: -2;
    bottom: 0;
}
.sp-product-features .sp-section-title{
    width:850px;
    margin:auto;
    margin-bottom: 72px;
    text-align: center;
}
.sp-product-features-list{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-gap: 56px;
    grid-column-gap: 124px;
    width:850px;
    margin:auto;
    text-align: center;
}

.sp-feature-number{
    font-size:3.5em;
    margin: 0;
    
}
.sp-footer{
    padding: 24px 0;

    background-color: #2B2B2B;
    color: rgba(255,255,255,0.7);
    border-top: 1px solid var(--back-color-faded);
    text-align: center;
    
}

button{
    padding:16px 32px;

    border:none;
    border-radius:40px;

    cursor: pointer;
}
.sp-primary-button{
    padding:16px 42px;

    background-color: var(--primary-color);
    color: var(--back-color);

    transition: ease-in-out .3s;;
}
.sp-primary-button:hover{
    opacity:0.8;
}

.sp-primary-button:active{
    opacity:0.6;
}

.sp-product-details .sp-primary-button{
    display:block;

    margin: auto;
    margin-top: 42px;
    padding:16px 120px;

    font-size: 1.4em;
}
</style>
</head>

